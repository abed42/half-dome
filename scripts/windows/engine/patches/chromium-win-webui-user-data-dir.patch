+std::wstring ResolvedFolder(std::wstring path) {
+  std::wstring rest;
+  while (!path.empty() &&
+         ::GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) {
+    const size_t slash = path.find_last_of(L'\\');
+    if (slash == std::wstring::npos)
+      return std::wstring();
+    rest = path.substr(slash) + rest;
+    path.resize(slash);
+  }
+  if (path.empty())
+    return std::wstring();
+  HANDLE handle = ::CreateFileW(
+      path.c_str(), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+      nullptr, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+  if (handle == INVALID_HANDLE_VALUE)
+    return std::wstring();
+  constexpr DWORD kFlags = VOLUME_NAME_GUID | FILE_NAME_NORMALIZED;
+  std::wstring resolved;
+  const DWORD size = ::GetFinalPathNameByHandleW(handle, nullptr, 0, kFlags);
+  if (size > 0) {
+    resolved.resize(size);
+    const DWORD written =
+        ::GetFinalPathNameByHandleW(handle, &resolved[0], size, kFlags);
+    resolved.resize(written > 0 && written < size ? written : 0);
+  }
+  ::CloseHandle(handle);
+  if (resolved.empty())
+    return resolved;
+  while (!resolved.empty() && resolved.back() == L'\\')
+    resolved.pop_back();
+  return resolved + rest;
+}
+
+bool WithinOrSameFolder(const std::wstring& inner, const std::wstring& outer) {
+  if (inner.size() < outer.size() ||
+      ::CompareStringOrdinal(inner.c_str(), static_cast<int>(outer.size()),
+                             outer.c_str(), static_cast<int>(outer.size()),
+                             TRUE) != CSTR_EQUAL) {
+    return false;
+  }
+  return inner.size() == outer.size() || inner[outer.size()] == L'\\';
+}
+
+std::wstring WithTrailingSlash(std::wstring path) {
+  if (!path.empty() && path.back() != L'\\')
+    path.push_back(L'\\');
+  return path;
+}
+
+bool IsWebUIShell(const std::wstring& command_line) {
+  return GetCommandLineSwitchValue(command_line, L"ardia-shell") == L"webui";
+}
+
+bool JoinsReactNativeFolders(const std::wstring& folder) {
+  const std::wstring mine = ResolvedFolder(folder);
+  if (mine.empty())
+    return true;
+  for (const wchar_t* variable : {L"LOCALAPPDATA", L"APPDATA"}) {
+    const std::wstring base = GetEnvironmentString(variable);
+    if (base.empty())
+      continue;
+    const std::wstring theirs =
+        ResolvedFolder(WithTrailingSlash(base) + L"Ardia");
+    if (theirs.empty() || WithinOrSameFolder(mine, theirs) ||
+        WithinOrSameFolder(theirs, mine)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void RefuseWebUIShell() {
+  ::TerminateProcess(::GetCurrentProcess(), 1);
+}
